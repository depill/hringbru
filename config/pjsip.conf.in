[global]
type=global
user_agent=Hringbru
endpoint_identifier_order=ip

[carrier-transport]
type=transport
protocol=@@HRINGDU_TRANSPORT@@
bind=0.0.0.0:5060
external_signaling_address=@@PUBLIC_IPV4@@
external_media_address=@@PUBLIC_IPV4@@
@@LOCAL_NET_LINES@@

[teams-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
external_signaling_hostname=@@SBC_FQDN@@
external_media_address=@@PUBLIC_IPV4@@
@@LOCAL_NET_LINES@@
cert_file=/tls/fullchain.pem
priv_key_file=/tls/privkey.pem
ca_list_file=/etc/ssl/certs/ca-certificates.crt
method=tlsv1_2
verify_server=yes
verify_client=yes
require_client_cert=yes
allow_wildcard_certs=yes

[hringdu-auth]
type=auth
auth_type=userpass
username=@@HRINGDU_USERNAME@@
password= @@HRINGDU_PASSWORD@@

[hringdu-registration]
type=registration
transport=carrier-transport
outbound_auth=hringdu-auth
server_uri=sip:@@HRINGDU_HOST@@:@@HRINGDU_PORT@@
client_uri=sip:@@HRINGDU_USERNAME@@@@@HRINGDU_HOST@@:@@HRINGDU_PORT@@
contact_user=@@HRINGDU_CONTACT_USER@@
retry_interval=60
forbidden_retry_interval=600
fatal_retry_interval=600
max_retries=10
expiration=300

[hringdu-aor]
type=aor
contact=sip:@@HRINGDU_HOST@@:@@HRINGDU_PORT@@
qualify_frequency=60
qualify_timeout=5

[hringdu]
type=endpoint
transport=carrier-transport
context=from-hringdu
identify_by=ip
disallow=all
allow=alaw,ulaw
aors=hringdu-aor
outbound_auth=hringdu-auth
from_user=@@HRINGDU_FROM_USER@@
from_domain=@@HRINGDU_HOST@@
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
rtp_timeout=120
rtp_timeout_hold=1800
dtmf_mode=rfc4733
trust_id_inbound=yes
send_pai=yes
allow_transfer=no
allow_subscribe=no

[hringdu-identify]
type=identify
endpoint=hringdu
@@HRINGDU_MATCH_LINES@@

[teams-base](!)
type=endpoint
transport=teams-tls
context=from-teams
identify_by=ip
disallow=all
allow=alaw,ulaw
direct_media=no
media_encryption=sdes
media_encryption_optimistic=no
srtp_tag_32=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=no
from_domain=@@SBC_FQDN@@
contact_user=hringbru
dtmf_mode=rfc4733
trust_id_inbound=yes
send_pai=yes
allow_transfer=no
allow_subscribe=no
timers=yes
rtp_timeout=120
rtp_timeout_hold=1800

@@TEAMS_PEERS@@
[teams-identify]
type=identify
endpoint=teams1
match=52.112.0.0/14
match=52.120.0.0/14
