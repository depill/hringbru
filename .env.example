# Literal KEY=value syntax, parsed by scripts/render.py; never sourced by a shell.
# Deployment-specific values are intentionally blank. Fill them in your private .env.
# Do not put the SIP password here. Use secrets/hringdu_password (one line).
# Docker project identity; keep stable after deployment to preserve its data volume.
HRINGBRU_PROJECT_NAME=hringbru
# Explicit Icelandic DIDs owned by this trunk, comma-separated E.164; no implicit number range.
DID_NUMBERS=
SBC_FQDN=
PUBLIC_IPV4=
# Private interface subnet(s) when behind 1:1 NAT, comma-separated. Never 0.0.0.0/0.
LOCAL_NETS=
ACME_EMAIL=
HRINGDU_HOST=
HRINGDU_PORT=5060
# Supply the carrier authentication username.
HRINGDU_USERNAME=
# Get the complete signalling source IPv4/CIDR list from Hringdu. Required.
HRINGDU_SIGNAL_CIDRS=
# Media sources can differ from the registrar; obtain this full list too.
HRINGDU_MEDIA_CIDRS=
# UDP is an assumption until Hringdu confirms it; TCP is also supported.
HRINGDU_TRANSPORT=udp
# Request-URI is authoritative by default. 'to' requires a captured call and carrier confirmation.
HRINGDU_DID_SOURCE=request_uri
# Registration contact user cannot identify 20 distinct DIDs. Hringdu must deliver the DID.
HRINGDU_CONTACT_USER=
# Confirm national / e164 / international (00 prefix) with Hringdu.
HRINGDU_DIAL_FORMAT=national
# Set FROM_USER to the account login if required by the carrier; blank uses the validated caller DID.
# The verified DID is also sent in P-Asserted-Identity. Confirm carrier support.
HRINGDU_FROM_USER=
HRINGDU_CLI_FORMAT=national
RTP_START=10000
RTP_END=10199
# Domestic Iceland calls and 112 only initially. Enable international after carrier confirmation.
ALLOW_INTERNATIONAL=false
