#!/usr/bin/env python3
"""Deploy, audit, or bootstrap Hringbru over SSH with Ansible."""
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent


def payload_files():
    files = ['Dockerfile', '.dockerignore', 'compose.yaml']
    files += [str(p.relative_to(ROOT)) for p in sorted((ROOT / 'config').iterdir()) if p.is_file()]
    files += ['scripts/' + name for name in ('entrypoint.sh', 'render.py', 'certificates.py', 'deploy-server.py')]
    return files


def validate_inventory(inventory):
    executable = shutil.which('ansible-inventory')
    if not executable:
        raise ValueError('Install Ansible first: brew install ansible (macOS), or pipx install ansible-core.')
    result = subprocess.run([executable, '-i', str(inventory), '--list'], capture_output=True, text=True)
    if result.returncode:
        raise ValueError('Ansible could not parse the inventory. Check its YAML and SSH host settings.')
    try:
        groups = json.loads(result.stdout)
    except json.JSONDecodeError:
        raise ValueError('Ansible did not return valid inventory JSON.') from None
    def hosts(group, visited):
        if group in visited:
            return set()
        visited.add(group)
        data = groups.get(group, {})
        result = set(data.get('hosts', []))
        for child in data.get('children', []):
            result.update(hosts(child, visited))
        return result
    if len(hosts('hringbru', set())) != 1:
        raise ValueError('Inventory must contain exactly one host in the hringbru group.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--inventory', type=Path, default=ROOT / 'deploy/ansible/inventory.yml')
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--validate', action='store_true', help='Validate local inputs only, without SSH.')
    mode.add_argument('--check-server', action='store_true', help='Audit host prerequisites without sudo, Python, or configuration changes.')
    mode.add_argument('--bootstrap', action='store_true', help='Install base dependencies via su; prompts for the server root password.')
    parser.add_argument('--syntax-check', action='store_true', help='Check playbook syntax only, without SSH.')
    parser.add_argument('--ask-become-pass', action='store_true', help='Prompt for the remote sudo password during normal deployment.')
    args = parser.parse_args()
    files = payload_files()
    fingerprint = '0' * 64
    inventory = args.inventory.resolve()
    if args.syntax_check and not inventory.exists():
        inventory = ROOT / 'deploy/ansible/inventory.example.yml'
    if not args.syntax_check and not (args.bootstrap or args.check_server):
        spec = importlib.util.spec_from_file_location('render', ROOT / 'scripts/render.py')
        render = importlib.util.module_from_spec(spec); spec.loader.exec_module(render)
        values = render.read_env(ROOT / '.env')
        password = (ROOT / 'secrets/hringdu_password').read_text().removesuffix('\n')
        render.validate(values, password)
        email = render.checked(values, 'ACME_EMAIL', r'[^\s@]+@[^\s@]+\.[^\s@]+')
        if email.endswith(('@example.com', '@example.net', '@example.org')):
            raise ValueError('Set ACME_EMAIL to your real renewal contact address.')
        if not inventory.is_file():
            raise ValueError('Copy deploy/ansible/inventory.example.yml to inventory.yml and set the SSH target.')
        digest = hashlib.sha256()
        for name in files + ['.env', 'secrets/hringdu_password']:
            digest.update(name.encode()); digest.update(b'\0'); digest.update((ROOT / name).read_bytes()); digest.update(b'\0')
        fingerprint = digest.hexdigest()
        validate_inventory(inventory)
        if args.validate:
            print('Local deployment inputs are valid. No SSH connection or server changes were made.')
            return 0
    if not args.syntax_check and (args.bootstrap or args.check_server):
        if not inventory.is_file():
            raise ValueError('Configure deploy/ansible/inventory.yml with the SSH target first.')
        validate_inventory(inventory)
    executable = shutil.which('ansible-playbook')
    if not executable:
        raise ValueError('Install Ansible first: brew install ansible (macOS), or pipx install ansible-core.')
    with tempfile.TemporaryDirectory(prefix='hringbru-ansible-') as temp:
        extra = Path(temp) / 'vars.json'
        extra.write_text(json.dumps({'hringbru_source': str(ROOT), 'hringbru_files': files, 'hringbru_version': fingerprint}))
        extra.chmod(0o600)
        playbook = 'bootstrap.yml' if args.bootstrap else 'check-server.yml' if args.check_server else 'deploy.yml'
        command = [executable, '-i', str(inventory), str(ROOT / 'deploy/ansible' / playbook), '-e', '@' + str(extra)]
        if args.syntax_check: command.append('--syntax-check')
        if not args.syntax_check and args.bootstrap:
            print('Bootstrap uses su: enter the SERVER ROOT password at the Ansible prompt.', flush=True)
            command.append('--ask-become-pass')
        elif args.ask_become_pass and not args.check_server:
            command.append('--ask-become-pass')
        return subprocess.run(command, cwd=ROOT).returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError) as error:
        print(f'Deployment input error: {error}', file=sys.stderr)
        sys.exit(1)
